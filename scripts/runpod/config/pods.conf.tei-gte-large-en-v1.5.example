# Config for scripts/runpod/create_pods.sh — the Alibaba-NLP/gte-large-en-v1.5
# embedding pod (docker/tei-runpod-gte-large-en-v1.5/). Copy to pods.conf and
# edit; pods.conf is gitignored so local overrides never get committed. Values
# here are shell variable assignments (sourced directly), not YAML.
#
# Usage:
#   cp scripts/runpod/config/pods.conf.tei-gte-large-en-v1.5.example scripts/runpod/config/pods.conf
#   export RUNPOD_API_KEY=...
#   scripts/runpod/create_pods.sh -n 1
#
# Same pod shape as pods.conf.tei.example (HTTP through RunPod's proxy, same
# /health readiness check, same idle-watchdog contract) — this file exists
# because four values genuinely differ for this image: IMAGE, GPU_TYPE_ID,
# CONTAINER_DISK_GB, and the EXTRA_ENV tuning defaults. Each is flagged below.
#
# RUNPOD_API_KEY is NOT set here — export it in your shell before running the
# script. It authenticates the pod-creation API call itself (this always needs
# the raw key — RunPod Secrets are substituted inside a running pod, not in
# requests to create one).

# DIFFERS from pods.conf.tei.example. Self-contained image: gte-large-en-v1.5
# is baked in at build time (see docker/tei-runpod-gte-large-en-v1.5/README.md)
# — no volume mount, no first-boot download. Bump the tag after
# rebuilding/pushing.
IMAGE="ghcr.io/<you>/tei-runpod-gte-large-en-v1.5:v0.1.0"

# DIFFERS from pods.conf.tei.example, and from this repo's bge-large config
# (which suggests an RTX 4090) — deliberately, for the reason below.
#
# The weights are small (~434M params, well under 1 GB in fp16), so on
# parameter count alone a 24 GB card would be plenty and a 4090 would be the
# throughput-per-dollar winner. But this is the one model in this repo that
# accepts 8192-token inputs, and activation memory scales with sequence
# length — so with genuinely long documents, VRAM becomes the binding
# constraint well before the parameter count suggests. The L40S is the
# recommendation here because it pairs 48 GB of headroom with Ada-generation
# speed (~864 GB/s, nearly 3x an L4) and keeps the image's default
# TEI_TAG=89-1.5 — no rebuild.
#
# Alternatives, and when they're the better call:
#   NVIDIA GeForce RTX 4090  24 GB, Ada, ~1008 GB/s — faster still and often
#                            cheaper, also TEI_TAG=89-1.5. The right pick IF
#                            your inputs are short passages rather than long
#                            documents; 24 GB is the risk you're taking.
#   NVIDIA L4                24 GB, Ada, ~300 GB/s — cheapest, but both the
#                            slowest here AND the tightest on memory. Only
#                            for small/bursty short-input workloads.
#   NVIDIA A100 80GB         ~2039 GB/s and 80 GB — the safe answer if you
#                            routinely embed maximum-length documents.
#                            REQUIRES rebuilding with TEI_TAG=1.5 (the
#                            untagged compute-8.0 image, NOT "80-1.5" —
#                            that tag doesn't exist).
#
# None of this is benchmarked for this specific model — it's reasoning from
# bandwidth/compute specs plus the context-length argument. Measure with your
# REAL input-length distribution before sizing a pool:
#   scripts/runpod/http-pool/watch_gpu.sh -u https://<host> \
#       --metric te_request_count --unit embeds/s
#
# List currently available ids + pricing with:
#   curl -s https://rest.runpod.io/v1/gpuTypes \
#     -H "Authorization: Bearer $RUNPOD_API_KEY" | jq -r '.[].id'
GPU_TYPE_ID="NVIDIA L40S"
GPU_COUNT=1

# HTTP service exposed through RunPod's proxy at
# https://<pod-id>-8080.proxy.runpod.net
POD_KIND="http"
PORT=8080
HEALTH_PATH="/health"

# DIFFERS from pods.conf.tei.example (15 GB). The baked-in safetensors weights
# are ~1.7 GB on top of the TEI base image, vs. the much smaller merged
# SPECTER2; 20 GB leaves comfortable headroom for the image plus scratch.
# Volume is headroom only (persistent TEI logs land there).
CONTAINER_DISK_GB=20
VOLUME_GB=5
VOLUME_MOUNT_PATH="/workspace"

# RunPod cloud tier: SECURE (RunPod-operated DCs) or COMMUNITY (cheaper, less
# guaranteed availability). HTTP-proxied ports don't need SUPPORT_PUBLIC_IP
# (that only matters for TCP-exposed ports like the bertopic pod's SSH).
CLOUD_TYPE="SECURE"

# Name prefix; pods are named "<prefix>-<timestamp>-01", ...
POD_NAME_PREFIX="tei-gte-large-en-v15"

# Idle watchdog settings (the image's tei_idle_watchdog.sh), passed into the
# pod's environment. Auto-stops the pod after IDLE_MIN minutes of no new
# /embed requests.
IDLE_MIN=5
# Minutes a pod may live without EVER being used. The idle timer above does not
# start until first use, so bringing up a pool no longer races it; this bounds a
# pod that is never used, or whose model never loads.
STARTUP_GRACE_MIN=60
POLL_SEC=30

# Value for the created pod's own RUNPOD_API_KEY env var (used internally by
# the idle watchdog's self-stop REST call). Leave unset to fall back to the
# raw local RUNPOD_API_KEY (simplest, but the raw key ends up in the API
# request body and hosts.generated.*). Set to a RunPod Secret reference
# instead so the raw key never leaves RunPod's secret store — RunPod
# substitutes the real value only when the pod boots.
POD_ENV_RUNPOD_API_KEY='{{ RUNPOD_SECRET_runpod_api_key }}'

# DIFFERS from pods.conf.tei.example: the commented tuning values below are
# this image's own baked-in defaults (lower than the SPECTER2 image's
# A100/H100-tuned 131072/2048/512), so the hints match what you'd actually be
# overriding. Uncomment only to change them without rebuilding.
#
# Note TEI_MAX_BATCH_TOKENS=32768 is only ~4 maximum-length (8192-token)
# documents per batch. That's fine for short inputs; if you routinely send
# long ones, raise it only alongside a GPU that has the memory for it.
#
# TEI_POOLING is listed but should not be changed: gte-large-en-v1.5's own
# 1_Pooling/config.json specifies CLS pooling, and serving it with mean
# pooling produces quietly wrong embeddings rather than an error.
EXTRA_ENV=(
  # "TEI_MAX_BATCH_TOKENS=32768"
  # "TEI_MAX_CONCURRENT=512"
  # "TEI_MAX_CLIENT_BATCH=128"
  # "TEI_POOLING=cls"
)

# How long (seconds) to poll the new pod's /health before giving up.
HEALTH_TIMEOUT_SEC=300
HEALTH_POLL_INTERVAL_SEC=10

# Delay (seconds) between successive pod-creation calls when creating several
# at once. Irrelevant at -n 1 but harmless to leave set.
CREATE_DELAY_SEC=10

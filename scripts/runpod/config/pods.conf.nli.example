# Config for scripts/runpod/create_pods.sh — the zero-shot NLI pod
# (docker/nli-runpod/). Copy to pods.conf and edit; pods.conf is gitignored
# so local overrides never get committed. Values here are shell variable
# assignments (sourced directly), not YAML.
#
# RUNPOD_API_KEY is NOT set here — export it in your shell before running the
# script. It authenticates the pod-creation API call itself (this always needs
# the raw key — RunPod Secrets are substituted inside a running pod, not in
# requests to create one).
#
# By default the same raw key is also injected as each created pod's own
# RUNPOD_API_KEY env var (used internally by the idle watchdog's self-stop
# REST call). To avoid the raw key ever appearing in the API payload or in
# hosts.generated.*, store it as a RunPod Secret (console -> Secrets) and
# reference it instead via POD_ENV_RUNPOD_API_KEY below.

# Image to run on every created pod. Bump the tag after rebuilding/pushing.
IMAGE="ghcr.io/<you>/nli-runpod:v0.1.0"

# GPU type id exactly as RunPod expects it. List available ids with:
#   curl -s https://rest.runpod.io/v1/gpuTypes \
#     -H "Authorization: Bearer $RUNPOD_API_KEY" | jq -r '.[].id'
# An L4 (24 GB) is sufficient for DeBERTa-v3-large; A100 works too.
GPU_TYPE_ID="NVIDIA L4"
GPU_COUNT=1

# HTTP service exposed through RunPod's proxy at
# https://<pod-id>-8080.proxy.runpod.net (matches NLI_PORT in the Dockerfile).
POD_KIND="http"
PORT=8080
HEALTH_PATH="/health"

# Disk sizing (GB). The model is baked into the image, so volume storage is
# mostly headroom, not required for correctness.
CONTAINER_DISK_GB=10
VOLUME_GB=0
VOLUME_MOUNT_PATH="/workspace"

# RunPod cloud tier: SECURE (RunPod-operated DCs) or COMMUNITY (cheaper, less
# guaranteed availability). Verify this field name/values against the current
# RunPod API docs if pod creation fails with a cloudType error.
CLOUD_TYPE="SECURE"

# Name prefix; pods are named "<prefix>-<timestamp>-01", ...
POD_NAME_PREFIX="nli-runpod"

# Idle watchdog settings, passed into each pod's environment.
IDLE_MIN=5
POLL_SEC=30

# Value for the created pod's own RUNPOD_API_KEY env var. Leave unset to fall
# back to the raw local RUNPOD_API_KEY (simplest, but the raw key ends up in
# the API request body and hosts.generated.*). Set to a RunPod Secret
# reference instead so the raw key never leaves RunPod's secret store —
# RunPod substitutes the real value only when the pod boots.
POD_ENV_RUNPOD_API_KEY='{{ RUNPOD_SECRET_runpod_api_key }}'

# How long (seconds) to poll each new pod's /health before giving up.
HEALTH_TIMEOUT_SEC=300
HEALTH_POLL_INTERVAL_SEC=10

# Delay (seconds) between successive pod-creation calls when creating several
# at once. Staggers the (multi-GB, model-baked-in) image pulls instead of N
# pods all pulling simultaneously — mitigates possible shared-egress/registry
# contention if RunPod schedules several pods onto nearby nodes. Set to 0 to
# disable.
CREATE_DELAY_SEC=10
